# Server-only. Never prefix these variables with NEXT_PUBLIC_.

# PaiFlow platform (one token is used for every deploymentId in templates.json).
PAIFLOW_BASE_URL=https://beta.app.paiflow.xyz
# pfd_ developer token with Read and operate + selected deployments, or a pfk_
# deployment-bound token.
PAIFLOW_API_TOKEN=
# Force the Mock PaiFlow gateway even when a token is configured.
PAIFLOW_USE_MOCK=false

# Supabase (server-only access through the service-role key; the browser never
# talks to the database). When unset, an in-memory store is used and state
# resets on restart.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional cache tuning (milliseconds): PaiFlow read cache for the status
# route (default 10000, events ingestion runs 10-20s behind), FX rate cache
# (default 60000).
# PAIFLOW_READ_CACHE_MS=10000
# FX_CACHE_MS=60000
